+    .addReg(0).addImm(1)
+    .addReg(0).addImm(-344)
+    .addReg(X86::FS);
+
+  // 3. Put generation number into stack
+  // movq %r11, 16(%rbp)
+  BuildMI(MBB, MBBI, DL, TII.get(X86::MOV64mr))
